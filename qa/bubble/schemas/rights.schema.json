{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anagno.invalid/bubble-testing/1.0/rights.schema.json",
  "title": "rights",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rights_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "const": "approved"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "holder": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "allowed_uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "contains": {
              "const": "evaluation"
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "rights_id",
          "status",
          "license",
          "holder",
          "allowed_uses",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
