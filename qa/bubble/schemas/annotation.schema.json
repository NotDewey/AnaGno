{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anagno.invalid/bubble-testing/1.0/annotation.schema.json",
  "title": "annotation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "completeness": {
      "enum": [
        "count",
        "box",
        "mask"
      ]
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "box": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ],
                "minItems": 4,
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "mask_path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mask_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "mask_path"
              ],
              "properties": {
                "mask_path": {
                  "type": "string"
                }
              }
            },
            "then": {
              "required": [
                "mask_path",
                "mask_sha256"
              ],
              "properties": {
                "mask_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
                },
                "mask_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "mask_sha256"
              ],
              "properties": {
                "mask_sha256": {
                  "type": "string"
                }
              }
            },
            "then": {
              "required": [
                "mask_path",
                "mask_sha256"
              ],
              "properties": {
                "mask_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
                },
                "mask_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "members"
        ],
        "additionalProperties": false
      }
    },
    "ignore_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mask_path",
          "mask_sha256",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "mask_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
          },
          "mask_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "width",
    "height",
    "completeness",
    "instances",
    "groups",
    "ignore_regions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "enum": [
              "box",
              "mask"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "instances": {
            "items": {
              "required": [
                "box"
              ],
              "properties": {
                "box": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completeness": {
            "const": "mask"
          }
        }
      },
      "then": {
        "properties": {
          "instances": {
            "items": {
              "required": [
                "mask_path",
                "mask_sha256"
              ],
              "properties": {
                "mask_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
                },
                "mask_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
